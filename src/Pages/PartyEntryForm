import React, { useState } from "react";

export default function PartyEntryForm() {
  const [formData, setFormData] = useState({
    partyName: "",
    location: "",
    bankName: "",
    acctNo: "",
    ifscCode: "",
  });

  const [parties, setParties] = useState([]);
  const [searchTerm, setSearchTerm] = useState("");

  const handleChange = (e) => {
    const { name, value } = e.target;
    setFormData((prev) => ({
      ...prev,
      [name]: name === "ifscCode" ? value.toUpperCase() : value,
    }));
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!formData.partyName || !formData.acctNo) return;

    const newParty = {
      id: Date.now(),
      ...formData,
    };

    setParties([newParty, ...parties]);
    handleReset();
  };

  const handleReset = () => {
    setFormData({
      partyName: "",
      location: "",
      bankName: "",
      acctNo: "",
      ifscCode: "",
    });
  };

  const filteredParties = parties.filter(
    (item) =>
      item.partyName.toLowerCase().includes(searchTerm.toLowerCase()) ||
      item.location.toLowerCase().includes(searchTerm.toLowerCase()) ||
      item.bankName.toLowerCase().includes(searchTerm.toLowerCase()) ||
      item.acctNo.includes(searchTerm) ||
      item.ifscCode.toLowerCase().includes(searchTerm.toLowerCase())
  );

  return (
    <div>
      <div className="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6 mx-auto">
        
        {/* Header Section */}
        <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-100 pb-5">
          <div>
            <h1 className="text-xl font-bold text-slate-900 tracking-tight">
              Party Master Entry
            </h1>
            <p className="text-xs text-slate-500 mt-1">
              Add and manage party bank account records and details.
            </p>
          </div>
        </div>

        {/* Input Form Card */}
        <form onSubmit={handleSubmit} className="bg-slate-50/80 p-5 rounded-xl border border-slate-200/80 space-y-4">
          <h2 className="text-xs font-bold text-slate-700 uppercase tracking-wider">
            Add New Party Details
          </h2>
          
          <div className="grid grid-cols-1 md:grid-cols-12 gap-4">
            
            {/* Party Name */}
            <div className="md:col-span-4 flex flex-col gap-1">
              <label className="text-xs font-semibold text-slate-600">
                Party Name <span className="text-rose-500">*</span>
              </label>
              <input
                type="text"
                name="partyName"
                value={formData.partyName}
                onChange={handleChange}
                placeholder="Enter party / company name"
                required
                className="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none shadow-xs"
              />
            </div>

            {/* Location */}
            <div className="md:col-span-4 flex flex-col gap-1">
              <label className="text-xs font-semibold text-slate-600">
                Location / Station
              </label>
              <input
                type="text"
                name="location"
                value={formData.location}
                onChange={handleChange}
                placeholder="City or Branch"
                className="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none shadow-xs"
              />
            </div>

            {/* Bank Name */}
            <div className="md:col-span-4 flex flex-col gap-1">
              <label className="text-xs font-semibold text-slate-600">
                Bank Name
              </label>
              <input
                type="text"
                name="bankName"
                value={formData.bankName}
                onChange={handleChange}
                placeholder="e.g. HDFC Bank, SBI"
                className="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none shadow-xs"
              />
            </div>

            {/* Account Number */}
            <div className="md:col-span-4 flex flex-col gap-1">
              <label className="text-xs font-semibold text-slate-600">
                Account No. <span className="text-rose-500">*</span>
              </label>
              <input
                type="text"
                name="acctNo"
                value={formData.acctNo}
                onChange={handleChange}
                placeholder="Enter account number"
                required
                className="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none shadow-xs font-mono"
              />
            </div>

            {/* IFSC Code */}
            <div className="md:col-span-4 flex flex-col gap-1">
              <label className="text-xs font-semibold text-slate-600">
                IFSC Code
              </label>
              <input
                type="text"
                name="ifscCode"
                value={formData.ifscCode}
                onChange={handleChange}
                maxLength={11}
                placeholder="e.g. HDFC0001234"
                className="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none shadow-xs uppercase font-mono"
              />
            </div>

            {/* Action Buttons */}
            <div className="md:col-span-4 flex items-end gap-2 pt-1">
              <button
                type="submit"
                className="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-lg text-xs transition shadow-xs"
              >
                Save Party
              </button>
              <button
                type="button"
                onClick={handleReset}
                className="bg-white hover:bg-slate-100 border border-slate-300 text-slate-600 font-medium py-2 px-4 rounded-lg text-xs transition shadow-xs"
              >
                Cancel
              </button>
            </div>

          </div>
        </form>

        {/* Existing Parties Table Header & Search */}
        <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-2">
          <h2 className="text-sm font-bold text-slate-800">
            Registered Parties List ({filteredParties.length})
          </h2>
          <div className="w-full sm:w-72 relative">
            <svg
              className="w-4 h-4 absolute left-3 top-2.5 text-slate-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              placeholder="Search saved parties..."
              className="w-full bg-white border border-slate-300 rounded-lg pl-9 pr-3 py-1.5 text-xs text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none shadow-xs"
            />
          </div>
        </div>

        {/* Table Container */}
        <div className="border border-slate-200 rounded-xl overflow-hidden shadow-xs">
          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs border-collapse">
              <thead>
                <tr className="bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold uppercase tracking-wider">
                  <th className="py-3.5 px-4 w-12">#</th>
                  <th className="py-3.5 px-4">Party Name</th>
                  <th className="py-3.5 px-4">Location</th>
                  <th className="py-3.5 px-4">Bank Name</th>
                  <th className="py-3.5 px-4">Acct. No.</th>
                  <th className="py-3.5 px-4">IFSC Code</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-100 bg-white">
                {filteredParties.length > 0 ? (
                  filteredParties.map((party, index) => (
                    <tr key={party.id} className="hover:bg-slate-50/60 transition">
                      <td className="py-3 px-4 font-mono text-slate-400">{index + 1}</td>
                      <td className="py-3 px-4 font-semibold text-slate-900">{party.partyName}</td>
                      <td className="py-3 px-4 text-slate-600">{party.location || "—"}</td>
                      <td className="py-3 px-4 text-slate-600">{party.bankName || "—"}</td>
                      <td className="py-3 px-4 font-mono text-slate-800">{party.acctNo}</td>
                      <td className="py-3 px-4 font-mono text-slate-800 uppercase">{party.ifscCode || "—"}</td>
                    </tr>
                  ))
                ) : (
                  <tr>
                    <td colSpan="6" className="py-12 text-center text-slate-400 bg-white">
                      <div className="flex flex-col items-center gap-2">
                        <svg className="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                        <span>No party records found. Fill out the form above to add a party.</span>
                      </div>
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  );
}
