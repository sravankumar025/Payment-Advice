    tNo: "TN-1003",
    partyName: "NEW SAIKRUPA TRADING COMPANY",
    station: "SARKHANI",
    brokerName: "Direct",
    location: "SARKHANI",
    cashDisc: 3200.0,
    unloading: 800.0,
    cashPaid: 0.0,
    shortage: 2100.0,
    lateLoad: 0.0,
    rateDiff: 1800.0,
    other1: 250.0,
  },
  {
    id: 4,
    date: "2026-08-15",
    tNo: "TN-1004",
    partyName: "SHREE RAMDWARKA FARMER PRODUCER COMPANY LTD.",
    station: "HADGAON",
    brokerName: "Rao & Sons",
    location: "HADGAON",
    cashDisc: 2100.0,
    unloading: 600.0,
    cashPaid: 1000.0,
    shortage: 850.0,
    lateLoad: 500.0,
    rateDiff: 0.0,
    other1: 0.0,
  },
  {
    id: 5,
    date: "2026-08-15",
    tNo: "TN-1005",
    partyName: "BALAJI AGRO ENTERPRISES",
    station: "NANDED",
    brokerName: "Srinivas Agencies",
    location: "NANDED",
    cashDisc: 1750.0,
    unloading: 350.0,
    cashPaid: 0.0,
    shortage: 0.0,
    lateLoad: 0.0,
    rateDiff: 1200.0,
    other1: 150.0,
  },
];

export default function () {
  const [deductions, setDeductions] = useState(INITIAL_DEDUCTIONS);
  const [selectedLocation, setSelectedLocation] = useState("ALL");
  const [selectedParty, setSelectedParty] = useState("ALL");
  const [selectedBroker, setSelectedBroker] = useState("ALL");
  const [enableDateFilter, setEnableDateFilter] = useState(false);
  const [fromDate, setFromDate] = useState("");
  const [toDate, setToDate] = useState("");
  const [hasSearched, setHasSearched] = useState(false);

  // Print Advice TNo range state
  const [tNoFrom, setTNoFrom] = useState("");
  const [tNoTo, setTNoTo] = useState("");

  const [notification, setNotification] = useState(null);
  const [isPrintModalOpen, setIsPrintModalOpen] = useState(false);
  const [isAddModalOpen, setIsAddModalOpen] = useState(false);
  const [printScope, setPrintScope] = useState("ALL"); // "ALL" or "ADVICE_RANGE"

  // Add New Entry Form State
  const [newEntry, setNewEntry] = useState({
    date: "2026-08-14",
    tNo: "",
    partyName: "",
    station: "",
    brokerName: "",
    cashDisc: "",
    unloading: "",
    cashPaid: "",
    shortage: "",
    lateLoad: "",
    rateDiff: "",
    other1: "",
  });

  const showNotification = (msg, type = "info") => {
    setNotification({ msg, type });
    setTimeout(() => setNotification(null), 3500);
  };

  // Extract distinct lists for dropdown options
  const locations = useMemo(() => {
    const set = new Set(deductions.map((item) => item.station).filter(Boolean));
    return ["ALL", ...Array.from(set)];
  }, [deductions]);

  const parties = useMemo(() => {
    const set = new Set(
      deductions.map((item) => item.partyName).filter(Boolean),
    );
    return ["ALL", ...Array.from(set)];
  }, [deductions]);

  const brokers = useMemo(() => {
    const set = new Set(
      deductions.map((item) => item.brokerName).filter(Boolean),
    );
    return ["ALL", ...Array.from(set)];
  }, [deductions]);

  // Filter dataset based on controls
  const filteredData = useMemo(() => {

    if (!hasSearched) return [];
    return deductions.filter((item) => {
      const matchesLocation =
        selectedLocation === "ALL" ||
        item.station.toLowerCase() === selectedLocation.toLowerCase();

      const matchesParty =
        selectedParty === "ALL" ||
        item.partyName.toLowerCase() === selectedParty.toLowerCase();

      const matchesBroker =
        selectedBroker === "ALL" ||
        item.brokerName.toLowerCase() === selectedBroker.toLowerCase();

      let matchesDate = true;
      if (enableDateFilter) {
        if (fromDate) matchesDate = matchesDate && item.date >= fromDate;
        if (toDate) matchesDate = matchesDate && item.date <= toDate;
      }

      return matchesLocation && matchesParty && matchesBroker && matchesDate;
    });
  }, [
    deductions,
    selectedLocation,
    selectedParty,
    selectedBroker,
    enableDateFilter,
    fromDate,
    toDate,
    hasSearched,
  ]);

  // Compute column totals
  const totals = useMemo(() => {
    return filteredData.reduce(
      (acc, item) => ({
        cashDisc: acc.cashDisc + (Number(item.cashDisc) || 0),
        unloading: acc.unloading + (Number(item.unloading) || 0),
        cashPaid: acc.cashPaid + (Number(item.cashPaid) || 0),
        shortage: acc.shortage + (Number(item.shortage) || 0),
        lateLoad: acc.lateLoad + (Number(item.lateLoad) || 0),
        rateDiff: acc.rateDiff + (Number(item.rateDiff) || 0),
        other1: acc.other1 + (Number(item.other1) || 0),
      }),
      {
        cashDisc: 0,
        unloading: 0,
        cashPaid: 0,
        shortage: 0,
        lateLoad: 0,
        rateDiff: 0,
        other1: 0,
      },
    );
  }, [filteredData]);

  const overallTotal = useMemo(() => {
    return Object.values(totals).reduce((a, b) => a + b, 0);
  }, [totals]);

  const handleReset = () => {
    setSelectedLocation("ALL");
    setSelectedParty("ALL");
    setSelectedBroker("ALL");
    setEnableDateFilter(true);
    setFromDate("");
    setToDate("");
    setTNoFrom("");
    setTNoTo("");
    setHasSearched(false);
    showNotification("Filters reset to default.");
  };

  const handleTransferToExcel = () => {
    if (filteredData.length === 0) {
      showNotification("No deduction data available to export!", "warning");
      return;
    }

    const headers = [
      "Date",
      "TNo.",
      "Name of Party",
      "Station",
      "Broker",
      "Cash Disc",
      "Unloading",
      "Cash Paid",
      "Shortage",
      "Late Load",
      "Rate Diff",
      "Other1",
      "Total Deductions",
    ];

    const rows = filteredData.map((d) => {
      const rowTotal =
        (d.cashDisc || 0) +
        (d.unloading || 0) +
        (d.cashPaid || 0) +
        (d.shortage || 0) +
        (d.lateLoad || 0) +
        (d.rateDiff || 0) +
        (d.other1 || 0);

      return [
        `"${d.date}"`,
        `"${d.tNo}"`,
        `"${d.partyName}"`,
        `"${d.station}"`,
        `"${d.brokerName}"`,
        d.cashDisc.toFixed(2),
        d.unloading.toFixed(2),
        d.cashPaid.toFixed(2),
        d.shortage.toFixed(2),
        d.lateLoad.toFixed(2),
        d.rateDiff.toFixed(2),
        d.other1.toFixed(2),
        rowTotal.toFixed(2),
      ];
    });

    rows.push([
      "Total",
      "",
      "",
      "",
      "",
      totals.cashDisc.toFixed(2),
      totals.unloading.toFixed(2),
      totals.cashPaid.toFixed(2),
      totals.shortage.toFixed(2),
      totals.lateLoad.toFixed(2),
      totals.rateDiff.toFixed(2),
      totals.other1.toFixed(2),
      overallTotal.toFixed(2),
    ]);

    const csvContent =
      "data:text/csv;charset=utf-8," +
      [headers.join(","), ...rows.map((e) => e.join(","))].join("\n");
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute(
      "download",
      `Deductions_Report_${fromDate}_to_${toDate}.csv`,
    );
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    showNotification("Deductions report exported to Excel CSV.");
  };

  const handlePrintAdviceClick = () => {
    if (!tNoFrom && !tNoTo) {
      setPrintScope("ALL");
    } else {
      setPrintScope("ADVICE_RANGE");
    }
    setIsPrintModalOpen(true);
  };

  const handleAddEntrySubmit = (e) => {
    e.preventDefault();
    if (!newEntry.partyName || !newEntry.tNo) {
      showNotification("Please enter Party Name and TNo.", "warning");
      return;
    }

    const newItem = {
      id: deductions.length + 1,
      date: newEntry.date || "2026-08-14",
      tNo: newEntry.tNo.toUpperCase(),
      partyName: newEntry.partyName.toUpperCase(),
      station: (newEntry.station || "MAIN").toUpperCase(),
      brokerName: newEntry.brokerName || "Direct",
      location: (newEntry.station || "MAIN").toUpperCase(),
      cashDisc: parseFloat(newEntry.cashDisc) || 0,
      unloading: parseFloat(newEntry.unloading) || 0,
      cashPaid: parseFloat(newEntry.cashPaid) || 0,
      shortage: parseFloat(newEntry.shortage) || 0,
      lateLoad: parseFloat(newEntry.lateLoad) || 0,
      rateDiff: parseFloat(newEntry.rateDiff) || 0,
      other1: parseFloat(newEntry.other1) || 0,
    };

    setDeductions([...deductions, newItem]);
    setIsAddModalOpen(false);
    setNewEntry({
      date: "2026-08-14",
      tNo: "",
      partyName: "",
      station: "",
      brokerName: "",
      cashDisc: "",
      unloading: "",
      cashPaid: "",
      shortage: "",
      lateLoad: "",
      rateDiff: "",
      other1: "",
    });
    showNotification("New Deduction record saved successfully!");
  };

  return (
    <div className="flex flex-col h-full bg-slate-100 font-sans text-slate-800 overflow-hidden">
      {/* Notification Banner */}
      {notification && (
        <div className="fixed top-4 right-4 z-50 px-4 py-2.5 rounded-xl shadow-lg bg-slate-900 text-white text-xs font-semibold flex items-center gap-2 animate-bounce">
          <span className="w-2 h-2 rounded-full bg-emerald-400"></span>
          {notification.msg}
        </div>
      )}

      {/* Top Application Title Header Bar */}
      <div className="bg-white px-6 py-3 border-b border-slate-200 flex items-center justify-between shrink-0 shadow-xs">
        <div className="text-center">
          <h2 className="text-xl font-black text-slate-900 tracking-tight">
            Deductions Report
          </h2>
        </div>
      </div>

      {/* Legacy Desktop Form Control Bar (Exact matching the uploaded image layout) */}
      <div className="bg-slate-200/90 border-b border-slate-300 px-6 py-3 shrink-0 shadow-xs text-xs">
        <div className="flex flex-col lg:flex-row lg:items-start justify-between gap-4">
          {/* Left Controls Column: Dropdowns & Date Range */}
          <div className="space-y-2 flex-1 max-w-2xl">
            {/* Select Location Dropdown */}
            <div className="flex items-center gap-3">
              <label className="w-32 text-right font-medium text-slate-700">
                Select Location
              </label>
              <select
                value={selectedLocation}
                onChange={(e) => setSelectedLocation(e.target.value)}
                className="flex-1 max-w-xs px-2.5 py-1 bg-white border border-slate-300 rounded text-xs font-semibold focus:outline-none focus:ring-1 focus:ring-slate-500 shadow-inner"
              >
                {locations.map((loc) => (
                  <option key={loc} value={loc}>
                    {loc === "ALL" ? "-- All Locations --" : loc}
                  </option>
                ))}
              </select>
            </div>

            {/* Select Party Name Dropdown */}
            <div className="flex items-center gap-3">
              <label className="w-32 text-right font-medium text-slate-700">
                Select Party Name
              </label>
              <select
                value={selectedParty}
                onChange={(e) => setSelectedParty(e.target.value)}
                className="flex-1 max-w-xs px-2.5 py-1 bg-white border border-slate-300 rounded text-xs font-semibold focus:outline-none focus:ring-1 focus:ring-slate-500 shadow-inner"
              >
                {parties.map((p) => (
                  <option key={p} value={p}>
                    {p === "ALL" ? "-- All Parties --" : p}
                  </option>
                ))}
              </select>
            </div>

            {/* Select Broker Name Dropdown */}
            <div className="flex items-center gap-3">
              <label className="w-32 text-right font-medium text-slate-700">
                Select Broker Name
              </label>
              <select
                value={selectedBroker}
                onChange={(e) => setSelectedBroker(e.target.value)}
                className="flex-1 max-w-xs px-2.5 py-1 bg-white border border-slate-300 rounded text-xs font-semibold focus:outline-none focus:ring-1 focus:ring-slate-500 shadow-inner"
              >
                {brokers.map((b) => (
                  <option key={b} value={b}>
                    {b === "ALL" ? "-- All Brokers --" : b}
                  </option>
                ))}
              </select>
            </div>

            {/* Select Date Checkbox & Date Pickers */}
            <div className="flex items-center gap-3 pt-1">
              <div className="w-32 flex justify-end items-center gap-1.5">
                <input
                  type="checkbox"
                  id="selectDateChk"
                  checked={enableDateFilter}
                  onChange={(e) => setEnableDateFilter(e.target.checked)}
                  className="rounded text-indigo-600 focus:ring-slate-500"
                />
                <label
                  htmlFor="selectDateChk"
                  className="font-medium text-slate-700 cursor-pointer"
                >
                  Select Date
                </label>
              </div>

              <div className="flex items-center gap-2">
                <span className="font-semibold text-slate-600">From</span>
                <input
                  type="date"
                  disabled={!enableDateFilter}
                  value={fromDate}
                  onChange={(e) => setFromDate(e.target.value)}
                  className="px-2 py-1 bg-white border border-slate-300 rounded text-xs font-medium disabled:bg-slate-100 disabled:text-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-500"
                />

                <span className="font-semibold text-slate-600 ml-2">To</span>
                <input
                  type="date"
                  disabled={!enableDateFilter}
                  value={toDate}
                  onChange={(e) => setToDate(e.target.value)}
                  className="px-2 py-1 bg-white border border-slate-300 rounded text-xs font-medium disabled:bg-slate-100 disabled:text-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-500"
                />
              </div>
            </div>
          </div>

          {/* Right Section: Print Advice Fieldset & Main Action Buttons */}
          <div className="flex flex-col items-end gap-3">
            {/* Print Advice Fieldset Box */}
            <fieldset className="border border-slate-400 rounded-md p-2 bg-slate-100/60 shadow-xs flex items-center gap-2">
              <legend className="px-1 text-[11px] font-semibold text-slate-600 uppercase">
                Print Advice
              </legend>

              <span className="font-semibold text-slate-700">TNo From</span>
              <input
                type="text"
                placeholder="1001"
                value={tNoFrom}
                onChange={(e) => setTNoFrom(e.target.value)}
                className="w-16 px-2 py-1 bg-white border border-slate-300 rounded text-xs text-center font-mono focus:outline-none focus:ring-1 focus:ring-slate-500"
              />

              <span className="font-semibold text-slate-700">To</span>
              <input
                type="text"
                placeholder="1005"
                value={tNoTo}
                onChange={(e) => setTNoTo(e.target.value)}
                className="w-16 px-2 py-1 bg-white border border-slate-300 rounded text-xs text-center font-mono focus:outline-none focus:ring-1 focus:ring-slate-500"
              />

              <button
                onClick={handlePrintAdviceClick}
                className="px-3 py-1 bg-slate-100 hover:bg-white border border-slate-400 text-slate-800 font-semibold rounded text-xs shadow-xs transition active:bg-slate-200"
              >
                Print
              </button>
            </fieldset>

            {/* Top Command Bar Buttons */}
            <div className="flex items-center gap-2 pt-2">
              <button
                onClick={() => {
                  setHasSearched(true);
                  showNotification("Filtered deductions report.");
                }}
                className="px-4 py-1.5 bg-slate-100 hover:bg-white border border-slate-300 text-slate-800 font-semibold rounded text-xs shadow-xs transition"
              >
                Show
              </button>

              <button
                onClick={handleTransferToExcel}
                className="px-3.5 py-1.5 bg-slate-100 hover:bg-white border border-slate-300 text-slate-800 font-semibold rounded text-xs shadow-xs flex items-center gap-1 transition"
              >
                <DownloadIcon /> Transfer to Excel...
              </button>

              <button
                onClick={handleReset}
                className="px-4 py-1.5 bg-slate-100 hover:bg-white border border-slate-300 text-slate-800 font-semibold rounded text-xs shadow-xs transition"
              >
                Cancel
              </button>
            </div>
          </div>
        </div>
      </div>

      {/* Grid Container */}
      <div className="flex-1 p-4 flex flex-col overflow-hidden">
        <div className="flex-1 bg-white border border-slate-300 rounded shadow-sm overflow-auto flex flex-col justify-between">
          <table className="w-full text-left border-collapse min-w-[950px]">
            <thead className="sticky top-0 bg-slate-100 border-b border-slate-300 text-xs font-bold text-slate-700 shadow-xs z-10">
              <tr>
                <th className="py-2 px-3 border-r border-slate-300 text-center w-24">
                  Date
                </th>
                <th className="py-2 px-3 border-r border-slate-300 font-mono w-24">
                  TNo.
                </th>
                <th className="py-2 px-3 border-r border-slate-300 min-w-[180px]">
                  Name of Party
                </th>
                <th className="py-2 px-3 border-r border-slate-300">Station</th>
                <th className="py-2 px-3 border-r border-slate-300 text-right">
                  Cash Disc
                </th>
                <th className="py-2 px-3 border-r border-slate-300 text-right">
                  Unloading
                </th>
                <th className="py-2 px-3 border-r border-slate-300 text-right">
                  Cash Paid
                </th>
                <th className="py-2 px-3 border-r border-slate-300 text-right">
                  Shortage
                </th>
                <th className="py-2 px-3 border-r border-slate-300 text-right">
                  Late Load
                </th>
                <th className="py-2 px-3 border-r border-slate-300 text-right">
                  Rate Diff
                </th>
                <th className="py-2 px-3 border-r border-slate-300 text-right">
                  Other1
                </th>
                <th className="py-2 px-3 border-r border-slate-300 text-right">
                  Other2
                </th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-200 text-xs font-medium text-slate-800">
              {filteredData.length > 0 ? (
                filteredData.map((row) => (
                  <tr key={row.id} className="hover:bg-amber-50/50 transition">
                    <td className="py-2 px-3 border-r border-slate-200 text-center font-mono text-slate-600">
                      {row.date}
                    </td>
                    <td className="py-2 px-3 border-r border-slate-200 font-mono font-bold text-indigo-700">
                      {row.tNo}
                    </td>
                    <td className="py-2 px-3 border-r border-slate-200 font-semibold uppercase">
                      {row.partyName}
                    </td>
                    <td className="py-2 px-3 border-r border-slate-200 uppercase text-slate-600">
                      {row.station}
                    </td>
                    <td className="py-2 px-3 border-r border-slate-200 text-right font-mono">
                      {row.cashDisc ? row.cashDisc.toFixed(2) : "-"}
                    </td>
                    <td className="py-2 px-3 border-r border-slate-200 text-right font-mono">
                      {row.unloading ? row.unloading.toFixed(2) : "-"}
                    </td>
                    <td className="py-2 px-3 border-r border-slate-200 text-right font-mono">
                      {row.cashPaid ? row.cashPaid.toFixed(2) : "-"}
                    </td>
                    <td className="py-2 px-3 border-r border-slate-200 text-right font-mono text-rose-600">
                      {row.shortage ? row.shortage.toFixed(2) : "-"}
                    </td>
                    <td className="py-2 px-3 border-r border-slate-200 text-right font-mono">
                      {row.lateLoad ? row.lateLoad.toFixed(2) : "-"}
                    </td>
                    <td className="py-2 px-3 border-r border-slate-200 text-right font-mono text-amber-700 font-semibold">
                      {row.rateDiff ? row.rateDiff.toFixed(2) : "-"}
                    </td>
                    <td className="py-2 px-3 text-right font-mono">
                      {row.other1 ? row.other1.toFixed(2) : "-"}
                    </td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colSpan={11} className="py-12 text-center text-slate-400">
                    No deduction records found matching the selected filter
                    criteria.
                  </td>
                </tr>
              )}
            </tbody>
          </table>

          {/* Total Summary Footer Row */}
        </div>
        <div className="sticky bottom-0 bg-yellow-100/90 border-t-2 border-slate-300 p-2.5 flex items-center justify-between text-xs font-bold text-slate-900 z-10 shadow-inner">
          <span className="uppercase tracking-wider">
            Totals ({filteredData.length} Records)
          </span>
          <div className="flex items-center gap-6 font-mono">
            <div className="bg-white px-3 py-1 border border-slate-300 rounded shadow-xs font-black text-sm text-indigo-900">
              Total: ₹{overallTotal.toFixed(2)}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
