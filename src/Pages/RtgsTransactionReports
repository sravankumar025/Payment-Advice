export default function RtgsTransactionReports() {
  const [transactions, setTransactions] = useState(INITIAL_RTGS_TRANSACTIONS);
  const [selectedDate, setSelectedDate] = useState("2026-08-14");
  const [sNoFrom, setSNoFrom] = useState("");
  const [sNoTo, setSNoTo] = useState("");
  const [searchTerm, setSearchTerm] = useState("");
  const [notification, setNotification] = useState(null);

  // Form State for Adding New Transaction
  const [newParty, setNewParty] = useState({
    partyName: "",
    station: "",
    acctNo: "",
    ifscCode: "",
    amount: "",
    chqNo: "",
    date: "2026-08-14"
  });

  const [currentTime, setCurrentTime] = useState("");

  const showNotification = (msg, type = "info") => {
    setNotification({ msg, type });
    setTimeout(() => setNotification(null), 3500);
  };

  const filteredData = useMemo(() => {
    return transactions.filter((item) => {
      const matchesDate = !selectedDate || item.date === selectedDate;

      const fromVal = sNoFrom !== "" ? parseInt(sNoFrom, 10) : null;
      const toVal = sNoTo !== "" ? parseInt(sNoTo, 10) : null;
      let matchesSNo = true;
      if (fromVal !== null) matchesSNo = matchesSNo && item.sNo >= fromVal;
      if (toVal !== null) matchesSNo = matchesSNo && item.sNo <= toVal;

      const matchesSearch =
        searchTerm === "" ||
        item.partyName.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.station.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.acctNo.includes(searchTerm) ||
        item.ifscCode.toLowerCase().includes(searchTerm.toLowerCase());

      return matchesDate && matchesSNo && matchesSearch;
    });
  }, [transactions, selectedDate, sNoFrom, sNoTo, searchTerm]);

  const totalAmount = useMemo(() => {
    return filteredData.reduce((acc, curr) => acc + (Number(curr.amount) || 0), 0);
  }, [filteredData]);

  const handleReset = () => {
    setSelectedDate("2026-08-14");
    setSNoFrom("");
    setSNoTo("");
    setSearchTerm("");
    showNotification("Filters reset to default.");
  };

  const handleTransferToExcel = () => {
    if (filteredData.length === 0) {
      showNotification("No data available to export!", "warning");
      return;
    }

    const headers = ["S.No.", "Name of Party", "Station", "Acct. No.", "IFSC Code", "Amount (₹)", "Chq No"];
    const rows = filteredData.map((t) => [
      t.sNo,
      `"${t.partyName}"`,
      `"${t.station}"`,
      `"${t.acctNo}"`,
      `"${t.ifscCode}"`,
      t.amount.toFixed(2),
      `"${t.chqNo || ""}"`
    ]);

    rows.push(["", "Total Amount", "", "", "", totalAmount.toFixed(2), ""]);

    const csvContent = "data:text/csv;charset=utf-8," + [headers.join(","), ...rows.map((e) => e.join(","))].join("\n");
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", `RTGS_Transaction_Report_${selectedDate || "all"}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    showNotification("Excel CSV report generated and downloaded.");
  };

  const handleAddTransaction = (e) => {
    e.preventDefault();
    if (!newParty.partyName || !newParty.acctNo || !newParty.amount) {
      showNotification("Please fill required fields (Party Name, Account No, Amount)", "warning");
      return;
    }

    const newItem = {
      sNo: transactions.length + 1,
      partyName: newParty.partyName.toUpperCase(),
      station: (newParty.station || "MAIN").toUpperCase(),
      acctNo: newParty.acctNo,
      ifscCode: (newParty.ifscCode || "SBIN000000").toUpperCase(),
      amount: parseFloat(newParty.amount) || 0,
      chqNo: newParty.chqNo,
      date: newParty.date || selectedDate
    };

    setTransactions([...transactions, newItem]);
    setIsAddModalOpen(false);
    setNewParty({ partyName: "", station: "", acctNo: "", ifscCode: "", amount: "", chqNo: "", date: "2026-08-14" });
    showNotification("New RTGS Transaction entry added successfully!");
  };

  return (
    <div>
      {notification && (
        <div className="fixed top-4 right-4 z-50 px-4 py-2.5 rounded-xl shadow-lg bg-slate-900 text-white text-xs font-semibold flex items-center gap-2 animate-bounce">
          <span className="w-2 h-2 rounded-full bg-emerald-400"></span>
          {notification.msg}
        </div>
      )}

      {}
      <div className="bg-white px-6 py-3 flex items-center justify-between shrink-0 shadow-xs">
        <div className="text-center">
          <h2 className="text-xl font-black text-slate-900 tracking-tight">RTGS Transaction Report</h2>
        </div>
      </div>

      {}
      <div className="bg-slate-200/90 border-b rounded-xl px-7 py-2.5 flex flex-wrap items-center justify-between gap-3 text-xs shrink-0 shadow-xs">
        <div className="flex flex-wrap items-center gap-4">
          <div className="flex items-center gap-2">
            <label className="font-semibold text-slate-700">Select Date</label>
            <input
                    type="date"
                    value={selectedDate}
                    onChange={(e) => setSelectedDate(e.target.value)}
                    className="w-full px-3 py-1.5 bg-white border border-slate-300 rounded-md text-sm focus:ring-2 focus:ring-indigo-500 outline-none"
                  />
          </div>

          <div className="h-4 w-px bg-slate-400 hidden sm:block"></div>

          <div className="flex items-center gap-1.5">
            <span className="font-semibold text-slate-700">SNo From</span>
            <input
              type="number"
              value={sNoFrom}
              onChange={(e) => setSNoFrom(e.target.value)}
              className="w-14 px-2 py-1 bg-white border border-slate-300 rounded text-xs text-center focus:outline-none focus:ring-1 focus:ring-slate-500"
              placeholder="1"
            />
            <span className="font-semibold text-slate-700">To</span>
            <input
              type="number"
              value={sNoTo}
              onChange={(e) => setSNoTo(e.target.value)}
              className="w-14 px-2 py-1 bg-white border border-slate-300 rounded text-xs text-center focus:outline-none focus:ring-1 focus:ring-slate-500"
              placeholder="99"
            />
          </div>

          <div className="h-4 w-px bg-slate-400 hidden md:block"></div>

          <div className="relative">
            <input
              type="text"
              placeholder="Search Party, Station, Account..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="pl-7 pr-3 py-1.5 bg-white border border-slate-300 rounded text-xs focus:outline-none focus:ring-1 focus:ring-slate-500 w-52"
            />
            <div className="absolute left-2 top-2">
              <SearchIcon />
            </div>
          </div>
        </div>

        {/* Right Command Action Buttons */}
        <div className="flex items-center gap-2">
          <button
            onClick={() => showNotification("Refreshed report data.")}
            className="px-3 py-1.5 bg-slate-100 border border-slate-300 hover:bg-white text-slate-800 font-semibold rounded text-xs shadow-xs transition"
