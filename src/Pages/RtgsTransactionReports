            <DownloadIcon /> Transfer to Excel...
          </button>
          <button
            onClick={handleReset}
            className="px-3 py-1.5 bg-slate-100 border border-slate-300 hover:bg-white text-slate-800 font-semibold rounded text-xs shadow-xs transition"
          >
            Cancel
          </button>
        </div>
      </div>

      {}
      <div className="flex-1 p-4 flex flex-col overflow-hidden">
        <div className="flex-1 bg-white border border-slate-300 rounded shadow-sm overflow-auto flex flex-col justify-between">
          <table className="w-full text-left border-collapse min-w-[800px]">
            <thead className="sticky top-0 bg-slate-100 border-b border-slate-300 text-xs font-bold text-slate-700 shadow-xs z-10">
              <tr>
                <th className="py-2 px-3 border-r border-slate-300 text-center w-16">S.No.</th>
                <th className="py-2 px-3 border-r border-slate-300">Name of Party</th>
                <th className="py-2 px-3 border-r border-slate-300">Station</th>
                <th className="py-2 px-3 border-r border-slate-300 font-mono">Acct. No.</th>
                <th className="py-2 px-3 border-r border-slate-300 font-mono">IFSC Code</th>
                <th className="py-2 px-3 border-r border-slate-300 text-right">Amount</th>
                <th className="py-2 px-3">Chq No</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-200 text-xs font-medium text-slate-800">
              {filteredData.length > 0 ? (
                filteredData.map((row) => (
                  <tr key={row.sNo} className="hover:bg-slate-50 transition">
                    <td className="py-2 px-3 border-r border-slate-200 text-center">{row.sNo}</td>
                    <td className="py-2 px-3 border-r border-slate-200 font-semibold uppercase">{row.partyName}</td>
                    <td className="py-2 px-3 border-r border-slate-200 uppercase">{row.station}</td>
                    <td className="py-2 px-3 border-r border-slate-200 font-mono text-slate-700">{row.acctNo}</td>
                    <td className="py-2 px-3 border-r border-slate-200 font-mono text-slate-700">{row.ifscCode}</td>
                    <td className="py-2 px-3 border-r border-slate-200 text-right font-mono font-bold text-slate-900">
                      {row.amount.toFixed(2)}
                    </td>
                    <td className="py-2 px-3 text-slate-500 font-mono">{row.chqNo || "-"}</td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colSpan={7} className="py-12 text-center text-slate-400">
                    No RTGS transaction records match the selected date or filter criteria.
                  </td>
                </tr>
              )}
            </tbody>
          </table>

          {}
          <div className="sticky bottom-0 bg-slate-100 border-t border-slate-300 p-2.5 flex items-center justify-end gap-3 z-10">
            <span className="font-bold text-xs text-slate-700">Total Amount</span>
            <div className="bg-yellow-100 border border-slate-300 px-4 py-1.5 rounded font-mono font-black text-sm text-slate-900 shadow-inner">
              {totalAmount.toFixed(2)}
            </div>
          </div>
        </div>
